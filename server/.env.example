PORT=3001
# Optional: used only after a failed run AND an explicit help request.
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Optional runtime overrides; npm run setup:compilers configures Windows automatically.
# CODEPREP_PYTHON_BIN=python
# CODEPREP_CPP_BIN=g++
# CODEPREP_C_BIN=gcc
# CODEPREP_JAVA_BIN=java
# CODEPREP_JAVAC_BIN=javac
# Scrapling uses its project-local Python environment installed by npm run setup.
# CODEPREP_SCRAPLING_ENABLED=false
# CODEPREP_SCRAPLING_PYTHON=/absolute/path/to/venv/bin/python
# CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
